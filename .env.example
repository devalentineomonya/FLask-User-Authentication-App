# Copy to .env and fill in real values: cp .env.example .env

# PostgreSQL
DB_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=healthcare
RABBITMQ_PASSWORD=change-me

# App secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional: admin account created on first startup
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-please

# Optional: SMTP for the notification worker (leave SMTP_SERVER empty to log emails instead)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
